# Environment Variables for Heartwise

# Flask Configuration
# Uncomment and set a strong secret key for production use
# FLASK_SECRET_KEY=your-strong-random-secret-here-min-32-chars

# Flask Debug Mode (0 = off, 1 = on)
# NEVER enable debug mode in production or shared environments
FLASK_DEBUG=0

# Server Host and Port
# Default: localhost only (127.0.0.1)
# Use 0.0.0.0 only in containerized/trusted environments
HOST=127.0.0.1
PORT=5000

# Example of how to generate a secure secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
